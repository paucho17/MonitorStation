# Copiar a .env y completar. El archivo .env NO debe subirse a ningun repositorio.
# Generar secretos:  openssl rand -hex 32

# PostgreSQL (base principal)
POSTGRES_DB=iotmangrove
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=CAMBIAR_clave_larga_para_postgres

# MySQL (base auxiliar)
MYSQL_DATABASE=iotmangrove_aux
MYSQL_USER=iot_aux
MYSQL_PASSWORD=CAMBIAR_clave_larga_para_mysql
MYSQL_ROOT_PASSWORD=CAMBIAR_clave_root_de_mysql

# JWT: compartido por ambas APIs, minimo 32 caracteres
JWT_SECRET=CAMBIAR_resultado_de_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=60

# Administrador inicial (se crea en el primer arranque si no existe)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@iotmangrove.info
ADMIN_PASSWORD=CAMBIAR_clave_del_administrador

# Gateway LoRa: la clave que debe enviar en la cabecera X-API-Key
GATEWAY_CODE=0XDD
GATEWAY_API_KEY=CAMBIAR_resultado_de_openssl_rand_hex_24

# Registro publico de usuarios (rol consulta)
ALLOW_REGISTRATION=true

# Solo necesario si el front-end se sirve desde otro dominio
CORS_ORIGINS=
